{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "pushbikejakarta.vercel.app" }
      ],
      "destination": "https://www.pushbikejakarta.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "pushbikejakarta.vercel.app" }
      ],
      "destination": "https://www.pushbikejakarta.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bayar",
      "destination": "/bayar.html"
    },
    {
      "source": "/merdeka",
      "destination": "/merdeka.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    }
  ]
}
